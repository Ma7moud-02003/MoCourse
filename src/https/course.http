### get all courses
GET  http://localhost:3000/api/course?categoryId=1
Authorization: Bearer YOUR_TOKEN_HERE
### get student courses
GET  http://localhost:3000/api/course/myCourses
Authorization: Bearer YOUR_TOKEN_HERE

### get instractor courses 
GET  http://localhost:3000/api/course/ins/myCourses
Authorization:Bearer YOUR_TOKEN_HERE
### details course

GET  http://localhost:3000/api/course/details/5
Authorization:Bearer YOUR_TOKEN_HERE
### enroll course for student
POST   http://localhost:3000/api/enrollment/5
Authorization: Bearer YOUR_TOKEN_HERE
### get user enrollment courses
GET  http://localhost:3000/api/enrollment
Authorization: Bearer YOUR_TOKEN_HERE

### Update course 
PATCH   http://localhost:3000/api/course/update/5
Authorization: Bearer YOUR_TOKEN_HERE
Content-Type: application/json

{
    "title": "Graphic Design Masterclass: Photoshop, Illustrator & Branding",
    "describtion": "Learn professional graphic design from scratch using Adobe Photoshop and Illustrator. Create logos, social media posts, business cards, flyers, posters, and complete branding projects while mastering color theory, typography, composition, and design principles.",
    "price": 5400,
    "covers": [
      "Design professional logos and brand identities",
      "Learn React fundamentals",
      "Create social media posts and marketing materials",
      "Understand typography, color theory, and composition",
      "Build a complete branding portfolio"
    ],
    "level": "advanced",
    "isPublished": false,
    "categoryId":2,
    "discountPrice": 4200,
    "duration": 80
    
}
 

### delete course 
DELETE    http://localhost:3000/api/course/delete/5
Authorization: Bearer YOUR_TOKEN_HERE
